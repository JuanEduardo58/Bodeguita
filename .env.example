# Copia este archivo como .env en la raíz del repo y cambia los valores.
# El .env nunca se sube a git.

POSTGRES_USER=bodeguita
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=bodeguita

# Solo para correr el backend o los tests fuera de Docker.
# Dentro de Docker, compose arma la URL con el host "db".
DATABASE_URL=postgresql+psycopg://bodeguita:cambia-esta-clave@127.0.0.1:55432/bodeguita

# Mínimo 32 caracteres. Genera una con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
